{
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
        "auto": true,
        "maxTokens": 300000
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php.bat",
                "artisan",
                "boost:mcp"
            ]
        },
        "laravel-telescope": {
            "type": "local",
            "enabled": true,
            "command": [
                "php.bat",
                "C:\\Users\\chiyo\\Desktop\\PROSKIP ALBAR\\ekaku-v3\\artisan",
                "telescope-mcp:server"
            ],
            "environment": {
                "APP_ENV": "local"
            }
        },
        "lighthouse": {
            "type": "local",
            "enabled": true,
            "command": [
                "lighthouse-mcp"
            ],
            "environment": {
                "CHROME_PATH": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
            }
        },
        "filesystem": {
            "type": "local",
            "enabled": true,
            "command": [
                "mcp-server-filesystem",
                "C:\\Users\\chiyo\\Desktop\\PROSKIP ALBAR\\ekaku-v3",
                "C:\\Users\\chiyo\\AppData\\Local\\Temp\\opencode"
            ]
        },
        "markitdown": {
            "type": "local",
            "enabled": true,
            "command": [
                "python",
                "-m",
                "markitdown_mcp"
            ]
        },
        "mendeley": {
            "type": "local",
            "enabled": true,
            "command": [
                "python",
                "-m",
                "mendeley_mcp.server"
            ]
        },
        "mcp-mermaid": {
            "type": "local",
            "enabled": true,
            "command": [
                "cmd",
                "/c",
                "npx",
                "-y",
                "mcp-mermaid"
            ]
        },
        "drawio": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "-y",
                "@drawio/mcp"
            ]
        }
    }
}
